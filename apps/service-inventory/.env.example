# Inventory Service Environment Variables
# .env ファイルにコピーして使用してください

# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ecommerce
DB_USER=postgres
DB_PASSWORD=postgres

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# gRPC
GRPC_PORT=50051

# HTTP (Health Check)
HTTP_PORT=8080

# Service
SERVICE_NAME=inventory-service
SERVICE_VERSION=1.0.0
SERVICE_ENVIRONMENT=development

# Logging
LOG_LEVEL=INFO
