/**
 * gRPC スキーマパッケージ
 * 
 * このパッケージは、Protocol Buffersによるスキーマ定義を管理します。
 * ここで定義されたスキーマから、TypeScriptとKotlinのコードが自動生成されます。
 * 
 * Single Source of Truth として機能し、フロントエンドとバックエンドの
 * 型安全性を保証します。
 */
{
  "name": "@ecommerce/grpc-schema",
  "version": "1.0.0",
  "description": "Protocol Buffers schema definitions",
  "private": true,
  "scripts": {
    "proto:generate": "npm run proto:generate:ts && npm run proto:generate:kt",
    "proto:generate:ts": "node scripts/generate-ts.js",
    "proto:generate:kt": "node scripts/generate-kt.js",
    "clean": "rm -rf generated"
  },
  "devDependencies": {
    "@bufbuild/protobuf": "^1.6.0",
    "@bufbuild/protoc-gen-es": "^1.6.0",
    "@connectrpc/protoc-gen-connect-es": "^1.2.0"
  }
}
